# Sketch2Design — sunucu ortam değişkenleri. Bu dosyayı .env.local olarak kopyalayıp doldur.
# .env.local git'e girmez; anahtar yalnızca sunucu kodunda (app/api/**, lib/llm.ts) kullanılır.

# Google AI Studio'dan alınan anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı: model adı (varsayılan: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
